---
import { socials } from '../data/site';
---
<footer>
  <div>
    <p>© {new Date().getFullYear()} Gaby Bui</p>
    <ul>
      {socials.map((s) => (
        <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--border); padding: 1.5rem 0; }
  div {
    max-width: var(--width);
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  p { margin: 0; }
  ul { list-style: none; display: flex; gap: 1.25rem; margin: 0; padding: 0; }
</style>
