---
import { url, stripBase } from '../utils/url';
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];
const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header>
  <nav aria-label="Main">
    <a class="brand" href={url('/')}>Gaby Bui</a>
    <ul>
      {links.map((l) => (
        <li><a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header { border-bottom: 1px solid var(--border); }
  nav {
    max-width: var(--width);
    margin: 0 auto;
    padding: 0.9rem 1rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .brand, .brand:visited { font-size: 1.6rem; color: #424242; }
  .brand:hover { color: var(--text); text-decoration: none; }
  ul { list-style: none; display: flex; gap: 1.25rem; margin: 0; padding: 0; }
  ul a, ul a:visited { color: var(--text); }
  ul a:hover { text-decoration: underline; }
  ul a[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
</style>
