---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/site';
---
<BaseLayout title="Projects" description="Selected data projects by Gaby Bui.">
  <h1>Projects</h1>
  <p class="lead">A few things I've built and worked on.</p>
  <div class="grid two">
    {projects.map((p) => (
      <a class="card" href={p.href}>
        <h3>{p.title}</h3>
        <p>{p.description}</p>
        <div>{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  a.card { color: inherit; display: block; }
  a.card:hover { text-decoration: none; }
</style>
