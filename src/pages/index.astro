---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/url';
import { site, socials } from '../data/site';
---
<BaseLayout>
  <div class="intro">
    <div class="text">
      <h1>Hi, I'm Gaby! </h1>
      <p>
        I work across the analytics stack.I most interested in pipeline and data engineering work, including designing tracking architectures, building ELT pipelines, and work with stakeholders to make multi-platform data reliable.
        I hold an MSc in Applied Data Science. 
        Would love to connect with fellow data enthusiasts to share ideas and learn from each other!
      </p>
      <p>
        <a class="btn" href={url('/about')}>About me</a>
        <a class="btn ghost" href={url('/projects')}>See my work</a>
      </p>
    </div>
    <img class="avatar" src={url('/gaby-avatar.jpg')} alt={`Portrait of ${site.name}`} width="240" height="240" />
  </div>

  <h2>Find me online</h2>
  <ul class="inline">
    {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}
  </ul>
</BaseLayout>

<style>
  .btn { margin-right: 0.5rem; margin-top: 0.5rem; }
  .inline { list-style: none; padding: 0; display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .intro { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; margin-bottom: 1.5rem; }
  .text { flex: 1; min-width: 0; }
  .avatar { width: 240px; height: 240px; border-radius: 4px; object-fit: cover; flex-shrink: 0; }
  @media (max-width: 560px) {
    .intro { flex-direction: column-reverse; }
    .avatar { width: 100%; max-width: 280px; height: auto; aspect-ratio: 1; }
  }
</style>
